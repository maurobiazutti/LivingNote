<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">📋 Seções do Currículo</h1>
      <p class="text-sm text-gray-400 mt-1">Gerencie formações, certificações, skills e idiomas em um só lugar.</p>
    </div>
    <%= link_to profile_path, class: "inline-flex items-center text-sm text-gray-400 hover:text-emerald-400 transition gap-2 group" do %>
      <span class="group-hover:-translate-x-1 transition-transform">←</span> Voltar ao Perfil
    <% end %>
  </div>

  <div data-controller="tabs" class="space-y-6">
    <div class="flex flex-wrap gap-2 border-b border-gray-800 pb-3" data-tabs-target="nav" role="tablist">
      <button type="button" data-action="click->tabs#select" data-tab="educations"
              class="tab-btn px-4 py-2.5 rounded-xl text-sm font-semibold transition border border-transparent"
              data-active="bg-emerald-600 text-white shadow-lg shadow-emerald-950/40"
              data-inactive="text-gray-400 hover:text-white hover:bg-gray-800">
        🎓 Formação
      </button>
      <button type="button" data-action="click->tabs#select" data-tab="certifications"
              class="tab-btn px-4 py-2.5 rounded-xl text-sm font-semibold transition border border-transparent"
              data-active="bg-emerald-600 text-white shadow-lg shadow-emerald-950/40"
              data-inactive="text-gray-400 hover:text-white hover:bg-gray-800">
        📜 Certificações
      </button>
      <button type="button" data-action="click->tabs#select" data-tab="skills"
              class="tab-btn px-4 py-2.5 rounded-xl text-sm font-semibold transition border border-transparent"
              data-active="bg-emerald-600 text-white shadow-lg shadow-emerald-950/40"
              data-inactive="text-gray-400 hover:text-white hover:bg-gray-800">
        💡 Skills
      </button>
      <button type="button" data-action="click->tabs#select" data-tab="languages"
              class="tab-btn px-4 py-2.5 rounded-xl text-sm font-semibold transition border border-transparent"
              data-active="bg-emerald-600 text-white shadow-lg shadow-emerald-950/40"
              data-inactive="text-gray-400 hover:text-white hover:bg-gray-800">
        🌐 Idiomas
      </button>
    </div>

    <section data-tabs-target="panel" data-panel="educations">
      <div class="flex justify-end mb-4">
        <%= link_to "+ Adicionar Formação", new_profile_education_path, data: { turbo_frame: "modal" }, class: "inline-flex items-center px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 rounded-xl text-sm font-semibold text-white transition shadow-lg shadow-emerald-950/40" %>
      </div>
      <%= render "educations/list", educations: @educations %>
    </section>

    <section data-tabs-target="panel" data-panel="certifications" class="hidden">
      <div class="flex justify-end mb-4">
        <%= link_to "+ Adicionar Certificação", new_profile_certification_path, data: { turbo_frame: "modal" }, class: "inline-flex items-center px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 rounded-xl text-sm font-semibold text-white transition shadow-lg shadow-emerald-950/40" %>
      </div>
      <%= render "certifications/list", certifications: @certifications %>
    </section>

    <section data-tabs-target="panel" data-panel="skills" class="hidden">
      <div class="flex justify-end mb-4">
        <%= link_to "+ Adicionar Skill", new_profile_skill_path, data: { turbo_frame: "modal" }, class: "inline-flex items-center px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 rounded-xl text-sm font-semibold text-white transition shadow-lg shadow-emerald-950/40" %>
      </div>
      <%= render "skills/list", skills: @skills %>
    </section>

    <section data-tabs-target="panel" data-panel="languages" class="hidden">
      <div class="flex justify-end mb-4">
        <%= link_to "+ Adicionar Idioma", new_profile_language_path, data: { turbo_frame: "modal" }, class: "inline-flex items-center px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 rounded-xl text-sm font-semibold text-white transition shadow-lg shadow-emerald-950/40" %>
      </div>
      <%= render "languages/list", languages: @languages %>
    </section>
  </div>

  <%= turbo_frame_tag "modal" %>
</div>