<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">🎓 Formação Acadêmica</h1>
      <p class="text-sm text-gray-400 mt-1">Gerencie seus cursos, diplomas e instituições.</p>
    </div>
    <%= link_to profile_path, class: "inline-flex items-center text-sm text-gray-400 hover:text-emerald-400 transition gap-2 group" do %>
      <span class="group-hover:-translate-x-1 transition-transform">←</span> Voltar ao Perfil
    <% end %>
  </div>

  <div class="flex justify-end">
    <%= link_to "+ Adicionar Formação", new_profile_education_path, class: "inline-flex items-center px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 rounded-xl text-sm font-semibold text-white transition shadow-lg shadow-emerald-950/40" %>
  </div>

  <% if @educations.any? %>
    <div class="space-y-3">
      <% @educations.each do |education| %>
        <div class="bg-gray-800/30 border border-gray-800 rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="space-y-1">
            <h3 class="text-white font-semibold"><%= education.degree %> <span class="text-gray-400 font-normal">— <%= education.institution %></span></h3>
            <% if education.course.present? %>
              <p class="text-sm text-gray-400"><%= education.course %></p>
            <% end %>
            <p class="text-xs text-gray-500">
              <%= education.start_date.strftime("%m/%Y") %> — <%= education.end_date ? education.end_date.strftime("%m/%Y") : "Cursando" %>
            </p>
          </div>
          <div class="flex items-center gap-2 sm:shrink-0">
            <%= link_to "Editar", edit_profile_education_path(education), class: "inline-flex items-center px-3 py-1.5 rounded-lg text-sm border border-gray-700 text-gray-300 hover:text-emerald-400 hover:border-emerald-500 transition" %>
            <%= button_to "Excluir", profile_education_path(education), method: :delete, data: { confirm: "Tem certeza que deseja excluir esta formação?" }, class: "inline-flex items-center px-3 py-1.5 rounded-lg text-sm border border-red-900/40 text-red-400 hover:bg-red-950/40 transition cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-gray-800/30 border border-dashed border-gray-700 rounded-2xl p-10 text-center">
      <div class="text-4xl mb-3">🎓</div>
      <p class="text-gray-400">Nenhuma formação cadastrada ainda.</p>
      <p class="text-sm text-gray-500 mt-1">Adicione sua primeira formação para começar a montar seu currículo.</p>
    </div>
  <% end %>
</div>