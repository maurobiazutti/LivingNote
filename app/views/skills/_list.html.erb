<div id="skills_list" class="space-y-3">
  <% if skills.any? %>
    <% skills.each do |skill| %>
      <div class="bg-gray-800/30 border border-gray-800 rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <h3 class="text-white font-semibold"><%= skill.name %></h3>
          <% if skill.level.present? %>
            <span class="inline-flex items-center rounded-full border border-emerald-900/40 bg-emerald-950/30 px-2.5 py-0.5 text-xs text-emerald-300">
              <%= skill.level %>
            </span>
          <% end %>
        </div>
        <div class="flex items-center gap-2 sm:shrink-0">
          <%= link_to "Editar", edit_profile_skill_path(skill), data: { turbo_frame: "modal" }, class: "inline-flex items-center px-3 py-1.5 rounded-lg text-sm border border-gray-700 text-gray-300 hover:text-emerald-400 hover:border-emerald-500 transition" %>
          <%= button_to "Excluir", profile_skill_path(skill), method: :delete, data: { confirm: "Tem certeza que deseja excluir esta skill?" }, class: "inline-flex items-center px-3 py-1.5 rounded-lg text-sm border border-red-900/40 text-red-400 hover:bg-red-950/40 transition cursor-pointer" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="bg-gray-800/30 border border-dashed border-gray-700 rounded-2xl p-10 text-center">
      <div class="text-4xl mb-3">💡</div>
      <p class="text-gray-400">Nenhuma skill cadastrada ainda.</p>
    </div>
  <% end %>
</div>