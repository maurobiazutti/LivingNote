<div id="certifications_list" class="space-y-3">
  <% if certifications.any? %>
    <% certifications.each do |certification| %>
      <div class="bg-gray-800/30 border border-gray-800 rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <h3 class="text-white font-semibold"><%= certification.name %></h3>
          <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-400">
            <% if certification.issuer.present? %>
              <span>🏛️ <%= certification.issuer %></span>
            <% end %>
            <% if certification.issue_date.present? %>
              <span>📅 <%= l certification.issue_date, format: "%m/%Y" %></span>
            <% end %>
          </div>
        </div>
        <div class="flex items-center gap-2 sm:shrink-0">
          <%= link_to "Editar", edit_profile_certification_path(certification), data: { turbo_frame: "modal" }, class: "inline-flex items-center px-3 py-1.5 rounded-lg text-sm border border-gray-700 text-gray-300 hover:text-emerald-400 hover:border-emerald-500 transition" %>
          <%= button_to "Excluir", profile_certification_path(certification), method: :delete, data: { confirm: "Tem certeza que deseja excluir esta certificação?" }, class: "inline-flex items-center px-3 py-1.5 rounded-lg text-sm border border-red-900/40 text-red-400 hover:bg-red-950/40 transition cursor-pointer" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="bg-gray-800/30 border border-dashed border-gray-700 rounded-2xl p-10 text-center">
      <div class="text-4xl mb-3">📜</div>
      <p class="text-gray-400">Nenhuma certificação cadastrada ainda.</p>
    </div>
  <% end %>
</div>