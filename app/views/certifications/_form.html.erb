<div class="space-y-6">
  <%= form_with(model: certification, url: certification.persisted? ? profile_certification_path(certification) : profile_certifications_path, method: certification.persisted? ? :patch : :post, local: true, class: "space-y-4") do |f| %>
    <% if certification.errors.any? %>
      <div class="bg-red-950/40 border border-red-900/50 rounded-2xl p-4 text-sm text-red-200">
        <div class="flex items-center gap-2 font-semibold text-red-400 mb-2">
          <span>⚠️</span> Ops! Verifique os campos abaixo:
        </div>
        <ul class="list-disc pl-5 space-y-1 text-gray-300">
          <% certification.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Nome da Certificação", class: "block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5" %>
      <%= f.text_field :name, placeholder: "Ex.: AWS Certified Solutions Architect", class: "w-full bg-gray-900/60 border border-gray-700/60 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition duration-200" %>
    </div>

    <div>
      <%= f.label :issuer, "Emissor (opcional)", class: "block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5" %>
      <%= f.text_field :issuer, placeholder: "Ex.: Amazon Web Services", class: "w-full bg-gray-900/60 border border-gray-700/60 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition duration-200" %>
    </div>

    <div>
      <%= f.label :issue_date, "Data de Emissão (opcional)", class: "block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5" %>
      <%= f.date_field :issue_date, class: "w-full bg-gray-900/60 border border-gray-700/60 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition duration-200" %>
    </div>

    <div>
      <%= f.submit certification.persisted? ? "Salvar Alterações" : "Adicionar Certificação", class: "w-full text-center px-4 py-3.5 bg-emerald-600 hover:bg-emerald-500 active:scale-[0.98] rounded-xl transition duration-150 font-semibold text-white shadow-lg shadow-emerald-950/40 cursor-pointer" %>
    </div>
  <% end %>
</div>