<div class="space-y-6">
  <%= form_with(model: @experience, url: @experience.persisted? ? profile_experience_path(@experience) : profile_experiences_path, method: @experience.persisted? ? :patch : :post, local: true, class: "space-y-4") do |f| %>
    <% if @experience.errors.any? %>
      <div class="bg-red-950/40 border border-red-900/50 rounded-2xl p-4 text-sm text-red-200">
        <div class="flex items-center gap-2 font-semibold text-red-400 mb-2">
          <span>⚠️</span> Ops! Verifique os campos abaixo:
        </div>
        <ul class="list-disc pl-5 space-y-1 text-gray-300">
          <% @experience.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :company, "Empresa", class: "block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5" %>
      <%= f.text_field :company, placeholder: "Ex.: Google Brasil", class: "w-full bg-gray-900/60 border border-gray-700/60 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition duration-200" %>
    </div>

    <div>
      <%= f.label :position, "Cargo", class: "block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5" %>
      <%= f.text_field :position, placeholder: "Ex.: Desenvolvedor Full Stack", class: "w-full bg-gray-900/60 border border-gray-700/60 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition duration-200" %>
    </div>

    <div>
      <%= f.label :description, "Descrição (opcional)", class: "block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5" %>
      <%= f.text_area :description, rows: 4, placeholder: "Descreva suas atividades e conquistas nessa experiência...", class: "w-full bg-gray-900/60 border border-gray-700/60 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition duration-200" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :start_date, "Data de Início", class: "block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5" %>
        <%= f.date_field :start_date, class: "w-full bg-gray-900/60 border border-gray-700/60 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition duration-200" %>
      </div>
      <div>
        <%= f.label :end_date, "Data de Término", class: "block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1.5" %>
        <%= f.date_field :end_date, class: "w-full bg-gray-900/60 border border-gray-700/60 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition duration-200" %>
      </div>
    </div>

    <div>
      <%= f.submit @experience.persisted? ? "Salvar Alterações" : "Adicionar Experiência", class: "w-full text-center px-4 py-3.5 bg-emerald-600 hover:bg-emerald-500 active:scale-[0.98] rounded-xl transition duration-150 font-semibold text-white shadow-lg shadow-emerald-950/40 cursor-pointer" %>
    </div>
  <% end %>
</div>